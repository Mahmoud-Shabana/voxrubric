      "rubric_tags": ["debugging"],
      "response_latency_ms": 510,
      "metadata": {
        "question_lane": "adaptive",
        "decision_reason": "investigate candidate evidence"
      }
    },
    {
      "id": "a2",
      "speaker": "candidate",
      "text": "Database spans rose while application CPU and event-loop lag stayed stable, so the dependency path became the stronger hypothesis.",
      "parent_turn_id": "q2",
      "rubric_tags": [],
      "response_latency_ms": null,
      "metadata": {}
    },
    {
      "id": "q3",
      "speaker": "interviewer",
      "text": "What system change reduced the chance of recurrence?",
